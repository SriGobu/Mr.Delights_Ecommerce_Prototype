# All optional. This prototype runs on mock data, so no backend URL is needed.

# Your deployed address, used for LinkedIn/WhatsApp link previews.
# Vercel fills this in automatically; only set it for a custom domain.
# VITE_SITE_URL=https://your-domain.com

# Override the contact details shown on the site and used for WhatsApp orders.
# VITE_WHATSAPP_NUMBER=91XXXXXXXXXX
# VITE_CONTACT_PHONE=+91 XXXXX XXXXX
# VITE_CONTACT_EMAIL=hello@example.com
